{
  "name": "style-guide-template",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "build:css": "sass --no-source-map scss/style-guide.scss css/style-guide.css",
    "vendor": "mkdir -p js/vendor && cp node_modules/fflate/esm/browser.js js/vendor/fflate.js",
    "start": "python3 -m http.server 8000",
    "dev": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "sass": "^1.108.2"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
